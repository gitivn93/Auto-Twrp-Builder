name: ANALizar y Extraer
on:
  workflow_dispatch:

jobs:
  analyze:
    if: github.event.repository.owner.id == github.event.sender.id
    runs-on: ubuntu-24.04
    permissions:
      contents: write
    steps:
      - name: Check Out
        uses: actions/checkout@v4

      - name: Prepare the environment
        run: |
          sudo apt update
          sudo apt -y upgrade
          
          # Instalación de dependencias nativas del sistema operando bajo la máquina base
          sudo apt -y install gperf gcc-multilib g++-multilib libc6-dev x11proto-dev libx11-dev tree lib32z-dev libgl1-mesa-dev libxml2-utils xsltproc bc ccache lib32readline-dev lib32z1-dev liblz4-tool libncurses-dev libsdl2-dev libwxgtk3.2-dev libxml2 lzop pngcrush schedtool squashfs-tools imagemagick libbz2-dev lzma ncftp qemu-user-static python3 cpio wget build-essential libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev llvm libncursesw5-dev xz-utils tk-dev libffi-dev liblzma-dev repo zip gh
          
          # Enlaces de compatibilidad para Clang Host
          sudo ln -sf /usr/lib/x86_64-linux-gnu/libtinfo.so.6 /usr/lib/x86_64-linux-gnu/libtinfo.so.5
          sudo ln -sf /usr/lib/x86_64-linux-gnu/libncurses.so.6 /usr/lib/x86_64-linux-gnu/libncurses.so.5
          sudo ln -sf /usr/lib/x86_64-linux-gnu/libncursesw.so.6 /usr/lib/x86_64-linux-gnu/libncursesw.so.5

          # Configuración e inyección nativa del entorno de Python 2 con Pyenv
          curl https://pyenv.run | bash
          export PATH="$HOME/.pyenv/bin:$PATH"
          eval "$(pyenv init -)"
          pyenv install 2.7.18
          pyenv global 2.7.18
          sudo ln -sf $HOME/.pyenv/versions/2.7.18/bin/python /usr/bin/python
          sudo ln -sf $HOME/.pyenv/versions/2.7.18/bin/python /usr/bin/python2
          
          pip3 install twrpdtgen --break-system-packages

      - name: Install OpenJDK
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '8'

      - name: Initialize repo
        id: pwd
        run: |
          mkdir workspace
          cd workspace
          echo "workspace-folder=$(pwd)" >> $GITHUB_OUTPUT
          git config --global user.name "azwhikaru"
          git config --global user.email "azwhikaru+37921907@github.com"
          /usr/bin/repo init --depth=1 -u https://github.com/minimal-manifest-twrp/platform_manifest_twrp_omni -b twrp-9.0

      - name: Repo Sync
        run: |
          export PATH="$HOME/.pyenv/versions/2.7.18/bin:$PATH"
          /usr/bin/repo sync -j$(nproc --all) --force-sync
        working-directory: workspace

      - name: Descargar Assets Sueltos y Reconstruir Árbol de Dispositivo Puro
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # 1. Creamos la estructura formal vacía y limpia que espera TWRP
          TARGET_TREE="device/alps/k50v1_64_bsp"
          mkdir -p "$TARGET_TREE/prebuilt"
          mkdir -p "$TARGET_TREE/rootdir"
          mkdir -p "$TARGET_TREE/recovery"
          mkdir -p "$TARGET_TREE/overlay"
          
          # 2. Descargamos tus archivos aplanados de la build anterior dentro de una carpeta temporal
          mkdir -p temp_extracted
          gh release download sources-30786185689 --repo gitivn93/Auto-Twrp-Builder --dir temp_extracted
          
          # 3. Mapeo y reubicación individual de cada archivo suelto a su directorio correcto
          [ -f temp_extracted/kernel ] && mv temp_extracted/kernel "$TARGET_TREE/prebuilt/kernel" || true
          [ -f temp_extracted/dtbo.img ] && mv temp_extracted/dtbo.img "$TARGET_TREE/prebuilt/dtbo.img" || true
          [ -f temp_extracted/recovery.fstab ] && mv temp_extracted/recovery.fstab "$TARGET_TREE/recovery.fstab" || true
          [ -f temp_extracted/init.recovery.rc ] && mv temp_extracted/init.recovery.rc "$TARGET_TREE/init.recovery.rc" || true
          [ -f temp_extracted/twrp.flags ] && mv temp_extracted/twrp.flags "$TARGET_TREE/twrp.flags" || true
          [ -f temp_extracted/Android.mk ] && mv temp_extracted/Android.mk "$TARGET_TREE/Android.mk" || true
          [ -f temp_extracted/AndroidProducts.mk ] && mv temp_extracted/AndroidProducts.mk "$TARGET_TREE/AndroidProducts.mk" || true
          [ -f temp_extracted/BoardConfig.mk ] && mv temp_extracted/BoardConfig.mk "$TARGET_TREE/BoardConfig.mk" || true
          [ -f temp_extracted/device.mk ] && mv temp_extracted/device.mk "$TARGET_TREE/device.mk" || true
          [ -f temp_extracted/omni.dependencies ] && mv temp_extracted/omni.dependencies "$TARGET_TREE/omni.dependencies" || true
          [ -f temp_extracted/vendorsetup.sh ] && mv temp_extracted/vendorsetup.sh "$TARGET_TREE/vendorsetup.sh" || true
          [ -f temp_extracted/Android.bp ] && mv temp_extracted/Android.bp "$TARGET_TREE/Android.bp" || true
          
          # Movemos cualquier archivo secundario .mk, .prop o .rc restante a la raíz por seguridad
          find temp_extracted/ -name "*.mk" -o -name "*.prop" -o -name "*.rc" -exec mv {} "$TARGET_TREE/" \; 2>/dev/null || true
          rm -rf temp_extracted
        working-directory: ${{ steps.pwd.outputs.workspace-folder }}

      - name: Generar Reporte de Validación Interno en la Raíz
        run: |
          TARGET_TREE="device/alps/k50v1_64_bsp"
          VALIDATION_LOG="$TARGET_TREE/tree_validation_report.txt"
          
          {
            echo "=========================================================="
            echo "   INFORME DE VALIDACIÓN DEL RECONSTRUCTED DEVICE TREE"
            echo "=========================================================="
            echo ""
            [ -f "$TARGET_TREE/BoardConfig.mk" ] && echo "✓ BoardConfig.mk ... encontrado" || echo "WARNING: No existe BoardConfig.mk"
            [ -f "$TARGET_TREE/AndroidProducts.mk" ] && echo "✓ AndroidProducts.mk ... encontrado" || echo "WARNING: No existe AndroidProducts.mk"
            [ -f "$TARGET_TREE/recovery.fstab" ] && echo "✓ recovery.fstab ... encontrado" || echo "WARNING: No existe recovery.fstab"
            [ -f "$TARGET_TREE/prebuilt/kernel" ] && echo "✓ kernel ... encontrado" || echo "WARNING: No existe kernel"
            [ -f "$TARGET_TREE/prebuilt/dtbo.img" ] && echo "✓ dtbo.img ... encontrado" || echo "WARNING: No existe dtbo.img"
            [ -f "$TARGET_TREE/device.mk" ] && echo "✓ device.mk ... encontrado" || echo "WARNING: No existe device.mk"
            [ -f "$TARGET_TREE/Android.mk" ] && echo "✓ Android.mk ... encontrado" || echo "WARNING: No existe Android.mk"
            echo ""
            echo "----------------------------------------------------------"
            echo " ANÁLISIS DE COMPONENTES AUXILIARES DE COLA DE TRABAJO"
            echo "----------------------------------------------------------"
            echo ""
            [ -f "$TARGET_TREE/vendorsetup.sh" ] && echo "✓ vendorsetup.sh ... encontrado" || echo "WARNING: No existe vendorsetup.sh"
            [ -f "$TARGET_TREE/omni.dependencies" ] && echo "✓ omni.dependencies ... encontrado" || echo "WARNING: No existe omni.dependencies"
            [ -f "$TARGET_TREE/Android.bp" ] && echo "✓ Android.bp ... encontrado" || echo "WARNING: No existe Android.bp"
            [ -f "$TARGET_TREE/init.recovery.rc" ] && echo "✓ init.recovery.rc ... encontrado" || echo "WARNING: No existe init.recovery.rc"
            [ -f "$TARGET_TREE/twrp.flags" ] && echo "✓ twrp.flags ... encontrado" || echo "WARNING: No existe twrp.flags"
            echo ""
            echo "=========================================================="
          } > "$VALIDATION_LOG"
          
          mkdir -p ../analysis_report
          cp "$VALIDATION_LOG" ../analysis_report/tree_validation.txt
        working-directory: ${{ steps.pwd.outputs.workspace-folder }}

      - name: Auditoría de Peso y Métricas Estadísticas
        run: |
          TARGET_DIR="device/alps/k50v1_64_bsp"
          NUM_FILES=$(find "$TARGET_DIR" -type f | wc -l)
          NUM_DIRS=$(find "$TARGET_DIR" -type d | wc -l)
          TOTAL_SIZE=$(du -sh "$TARGET_DIR" | awk '{print $1}')
          
          {
            echo "=========================================================="
            echo "ESTADÍSTICAS FÍSICAS DEL ENTORNO DE TRABAJO"
            echo "=========================================================="
            echo "Número de archivos: $NUM_FILES"
            echo "Número de directorios: $NUM_DIRS"
            echo "Peso total: $TOTAL_SIZE"
            echo "----------------------------------------------------------"
            echo "Peso del kernel: $(du -sh $TARGET_DIR/prebuilt/kernel 2>/dev/null | awk '{print $1}' || echo '0')"
            echo "Peso del dtbo: $(du -sh $TARGET_DIR/prebuilt/dtbo.img 2>/dev/null | awk '{print $1}' || echo '0')"
            echo "----------------------------------------------------------"
            echo "Número de mk: $(find $TARGET_DIR -name "*.mk" | wc -l)"
            echo "Número de rc: $(find $TARGET_DIR -name "*.rc" | wc -l)"
            echo "Número de fstab: $(find $TARGET_DIR -name "*fstab*" | wc -l)"
            echo "Número de xml: $(find $TARGET_DIR -name "*.xml" | wc -l)"
            echo "Número de blobs: $(find $TARGET_DIR -name "*.bin" -o -name "*.elf" | wc -l)"
            echo "Número de librerías: $(find $TARGET_DIR -name "*.so" | wc -l)"
            echo "Número de overlays: $(find $TARGET_DIR -type d -name "overlay" | wc -l)"
            echo "=========================================================="
            echo "INVENTARIO DE DIVISIONES POR EXTENSIONES:"
            find "$TARGET_DIR" -type f | sed 's/.*\.//' | sort | uniq -c | sort -nr
          } > ../analysis_report/device_tree_stats.txt
        working-directory: ${{ steps.pwd.outputs.workspace-folder }}

      - name: Generar Mapa Inviolable de Firmas (SHA256 Manifest)
        run: |
          find device/alps/k50v1_64_bsp/ -type f -exec sha256sum {} \; | sed 's|device/alps/k50v1_64_bsp/||' > ../analysis_report/sha256_manifest.txt
        working-directory: ${{ steps.pwd.outputs.workspace-folder }}

      - name: Aislar Módulos Médula de TWRP (Source Snapshot)
        run: |
          mkdir -p ../snapshot_source/bootable/recovery
          mkdir -p ../snapshot_source/system/core
          mkdir -p ../snapshot_source/vendor
          mkdir -p ../snapshot_source/build
          mkdir -p ../snapshot_source/external

          cp -r bootable/recovery/gui ../snapshot_source/bootable/recovery/ 2>/dev/null || true
          cp -r bootable/recovery/minui* ../snapshot_source/bootable/recovery/ 2>/dev/null || true
          cp -a bootable/recovery/res analysis_sources/

          cp bootable/recovery/twrp.cpp ../snapshot_source/bootable/recovery/ 2>/dev/null || true
          cp bootable/recovery/variables.h ../snapshot_source/bootable/recovery/ 2>/dev/null || true
          cp bootable/recovery/Android.* ../snapshot_source/bootable/recovery/ 2>/dev/null || true
          
          cp -r system/core/init ../snapshot_source/system/core/ 2>/dev/null || true
          cp -r system/core/fs_mgr ../snapshot_source/system/core/ 2>/dev/null || true
          cp -r system/vold ../snapshot_source/system/ 2>/dev/null || true
          cp -r system/extras ../snapshot_source/system/ 2>/dev/null || true
          
          cp -r vendor/omni ../snapshot_source/vendor/ 2>/dev/null || true
          cp -r build/make ../snapshot_source/build/ 2>/dev/null || true
          cp -r build/soong ../snapshot_source/build/ 2>/dev/null || true
          
          cp -r external/libtar ../snapshot_source/external/ 2>/dev/null || true
          cp -r external/freetype ../snapshot_source/external/ 2>/dev/null || true
          cp -r external/libpng ../snapshot_source/external/ 2>/dev/null || true
        working-directory: ${{ steps.pwd.outputs.workspace-folder }}

      - name: Empaquetar Bloques Estructurados de Laboratorio
        run: |
          tar -czf ../analysis_logs.tar.gz -C ../analysis_report .
          tar -czf ../source_snapshot.tar.gz -C ../snapshot_source .
          tar -czf ../Alps_device_tree.tar.gz device/alps/k50v1_64_bsp
        working-directory: ${{ steps.pwd.outputs.workspace-folder }}

      - name: Publicar Lanzamiento de Análisis en Releases
        uses: softprops/action-gh-release@v2
        with:
          files: |
            analysis_logs.tar.gz
            source_snapshot.tar.gz
            Alps_device_tree.tar.gz
          name: LAB-ANALYSIS-ALPS-${{ github.run_id }}
          tag_name: lab-build-${{ github.run_id }}
          body: |
